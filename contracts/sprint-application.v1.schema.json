{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinystudio.io/contracts/sprint-application.v1.schema.json",
  "title": "TinyStudio Sprint Application v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schemaVersion", "schemaDigest", "applicationId", "sourceHash", "submittedAt", "applicant", "qualification"],
  "properties": {
    "contract": { "const": "tinystudio.sprint-application" },
    "schemaVersion": { "const": 1 },
    "schemaDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "applicationId": { "type": "string", "format": "uuid" },
    "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "submittedAt": { "type": "string", "format": "date-time" },
    "applicant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "workEmail", "company", "website", "companyType", "targetBuyer", "primaryOffer", "mainLeadSource", "suspectedLeak", "desiredOutcome", "implementationAbility", "consent"],
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "workEmail": { "type": "string", "format": "email", "maxLength": 254 },
        "company": { "type": "string", "minLength": 2, "maxLength": 160 },
        "website": { "type": "string", "format": "uri", "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://(?:\\[(?:(?:[0-9A-Fa-f]{1,4}:){7}(?:[0-9A-Fa-f]{1,4}|:)|(?:[0-9A-Fa-f]{1,4}:){6}(?:(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|:[0-9A-Fa-f]{1,4}|:)|(?:[0-9A-Fa-f]{1,4}:){5}(?::(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|(?::[0-9A-Fa-f]{1,4}){1,2}|:)|(?:[0-9A-Fa-f]{1,4}:){4}(?:(?::[0-9A-Fa-f]{1,4}){0,1}:(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|(?::[0-9A-Fa-f]{1,4}){1,3}|:)|(?:[0-9A-Fa-f]{1,4}:){3}(?:(?::[0-9A-Fa-f]{1,4}){0,2}:(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|(?::[0-9A-Fa-f]{1,4}){1,4}|:)|(?:[0-9A-Fa-f]{1,4}:){2}(?:(?::[0-9A-Fa-f]{1,4}){0,3}:(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|(?::[0-9A-Fa-f]{1,4}){1,5}|:)|(?:[0-9A-Fa-f]{1,4}:){1}(?:(?::[0-9A-Fa-f]{1,4}){0,4}:(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|(?::[0-9A-Fa-f]{1,4}){1,6}|:)|(?::(?:(?::[0-9A-Fa-f]{1,4}){0,5}:(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|(?::[0-9A-Fa-f]{1,4}){1,7}|:)))\\]|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|(?:[A-Za-z0-9_~-]+\\.)*(?=[A-Za-z0-9_~-]*[A-Za-z_~])[A-Za-z0-9_~-]+)(?::(?:[0-9]{1,4}|[0-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#][A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]*)?$", "maxLength": 500 },
        "companyType": { "enum": ["managed-it", "msp", "cybersecurity", "hybrid", "other"] },
        "targetBuyer": { "type": "string", "minLength": 10, "maxLength": 800 },
        "primaryOffer": { "type": "string", "minLength": 10, "maxLength": 800 },
        "mainLeadSource": { "type": "string", "minLength": 2, "maxLength": 400 },
        "suspectedLeak": { "type": "string", "minLength": 10, "maxLength": 1200 },
        "desiredOutcome": { "type": "string", "minLength": 10, "maxLength": 800 },
        "implementationAbility": { "type": "string", "minLength": 2, "maxLength": 500 },
        "consent": { "const": true }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "packetHash", "promptVersion", "packet"],
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "ready" } }, "required": ["state"] },
          "then": {
            "properties": {
              "packetHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "packet": { "type": "object" }
            }
          },
          "else": {
            "properties": {
              "packetHash": { "const": "" },
              "packet": { "type": "null" }
            }
          }
        }
      ],
      "properties": {
        "state": { "enum": ["pending", "ready", "failed"] },
        "packetHash": { "type": "string", "pattern": "^$|^[a-f0-9]{64}$" },
        "promptVersion": { "type": "string", "maxLength": 80 },
        "packet": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["fitStatus", "fitReasons", "leakHypothesis", "missingInformation", "riskFlags", "recommendedNextStep"],
              "properties": {
                "fitStatus": { "enum": ["strong", "possible", "poor", "unknown"] },
                "fitReasons": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 300 } },
                "leakHypothesis": { "type": "string", "maxLength": 800 },
                "missingInformation": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 300 } },
                "riskFlags": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 300 } },
                "recommendedNextStep": { "type": "string", "maxLength": 500 }
              }
            }
          ]
        }
      }
    }
  }
}
